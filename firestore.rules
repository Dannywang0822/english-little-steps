rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the signed-in user can read/write their own tree.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /meta/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /cards/{chunkId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /sentences/{sentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
