  "scenes": [
    {
      "id": 1,
      "title": "A text message",
      "sentences": [
        {
          "en": "It is Saturday morning.",
          "zh": "现在是周六早上。"
        },
        {
          "en": "Leo gets up and has breakfast at home.",
          "zh": "Leo 起床后在家吃早餐。"
        },
        {
          "en": "There is a text message from Mia on his phone.",
          "zh": "他的手机上有一条 Mia 发来的短信。"
        },
        {
          "en": "The message says: \"Look at the board in our classroom.\"",
          "zh": "短信写着：“看看我们教室的黑板。”"
        },
        {
          "en": "\"That's strange,\" Leo thinks.",
          "zh": "“真奇怪，”Leo 想。"
        },
        {
          "en": "\"What does it mean?\"",
          "zh": "“这是什么意思？”"
        }
      ]
    },
    {
      "id": 2,
      "title": "At the school gate",
      "sentences": [
        {
          "en": "Leo meets Jay at the school gate.",
          "zh": "Leo 在学校门口遇见 Jay。"
        },
        {
          "en": "\"Mia says we need to look at the board,\" Leo says.",
          "zh": "“Mia 说我们得去看看黑板，”Leo 说。"
        },
        {
          "en": "\"OK, let's go to the classroom,\" Jay says.",
          "zh": "“好，我们去教室吧，”Jay 说。"
        },
        {
          "en": "They go together.",
          "zh": "他们一起走了。"
        }
      ]
    },
    {
      "id": 3,
      "title": "On the board",
      "sentences": [
        {
          "en": "Mia is in the classroom.",
          "zh": "Mia 在教室里。"
        },
        {
          "en": "The friends look at the board.",
          "zh": "三个朋友看着黑板。"
        },
        {
          "en": "There is a short message on the board. It says: \"Meet at the school gate at ten. Join the Saturday Club.\"",
          "zh": "黑板上有一条短留言，写着：“十点在学校门口见面。加入周六俱乐部。”"
        },
        {
          "en": "\"This is interesting,\" Mia says.",
          "zh": "“这很有意思，”Mia 说。"
        },
        {
          "en": "\"Who is this message from?\" Jay asks.",
          "zh": "“这条留言是谁发的？”Jay 问。"
        },
        {
          "en": "\"I want to find out who it is,\" Leo says.",
          "zh": "“我想弄清楚这是谁，”Leo 说。"
        }
      ]
    },
    {
      "id": 4,
      "title": "A small notice",
      "sentences": [
        {
          "en": "At ten o'clock, they meet at the school gate.",
          "zh": "十点，他们在学校门口见面。"
        },
        {
          "en": "They look for a teacher or a student, but they do not see anyone new.",
          "zh": "他们在找老师或同学，但没有看到任何新来的人。"
        },
        {
          "en": "Then Mia looks at the gate.",
          "zh": "后来 Mia 看了看大门。"
        },
        {
          "en": "There is a small notice on the gate. The notice says: \"Look for a blue book in the library. The name of the book is Saturday Club.\"",
          "zh": "门上有一张小告示，写着：“去图书馆找一本蓝色的书。书名是 Saturday Club。”"
        }
      ]
    },
    {
      "id": 5,
      "title": "In the library",
      "sentences": [
        {
          "en": "The friends go to the library.",
          "zh": "朋友们去图书馆。"
        },
        {
          "en": "They look for the blue book.",
          "zh": "他们寻找那本蓝书。"
        },
        {
          "en": "Leo finds it next to a window.",
          "zh": "Leo 在一扇窗户旁边找到了它。"
        },
        {
          "en": "Inside the book, there is a short letter. The letter says: \"Welcome to the Saturday Club. Come back next Saturday. Then you can find out more.\"",
          "zh": "书里有一封短信，写着：“欢迎来到周六俱乐部。下周六再来。那时你们就能知道更多。”"
        }
      ]
    },
    {
      "id": 6,
      "title": "Let's join",
      "sentences": [
        {
          "en": "The friends sit together and read the letter again.",
          "zh": "朋友们坐在一起，又读了一遍那封信。"
        },
        {
          "en": "\"This is a strange and interesting day,\" Mia says.",
          "zh": "“今天真奇怪，也很有意思，”Mia 说。"
        },
        {
          "en": "\"I want to join the club,\" Jay says.",
          "zh": "“我想加入这个俱乐部，”Jay 说。"
        },
        {
          "en": "\"Me too,\" Leo says.",
          "zh": "“我也是，”Leo 说。"
        },
        {
          "en": "\"Let's come back next Saturday. We can find out together.\"",
          "zh": "“我们下周六再来吧。我们可以一起弄清楚。”"
        },
        {
          "en": "On the next page of the book, there is one more message: \"See you next Saturday. Then you can find out my name.\"",
          "zh": "在书的下一页，还有一条留言：“下周六见。到时你们就能知道我的名字。”"
        }
      ]
    }
  ],
