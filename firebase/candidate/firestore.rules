rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /meta/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /cards/{chunkId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /sentences/{sentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // PROTOTYPE ONLY. Do not deploy this file by itself.
    // Paste these helpers and the englishLittleSteps match into
    // match /databases/{database}/documents, beside the existing matches.
    // The published file is firebase/published/firestore.rules. It contains
    // /users/{userId} plus meta, cards, logs, and sentences. Leave that text
    // unchanged. Do not add a catch-all deny. Names are prefixed els*.
    //
    // Path: englishLittleSteps/{userId}
    // One document per Firebase Auth uid. No email, token, or other collection's data.
    // Reviewed prototype for english-subject-ket. Not deployed.

    function elsSignedIn() {
      return request.auth != null;
    }

    function elsOwner(userId) {
      return elsSignedIn() && request.auth.uid == userId;
    }

    function elsKeysOk() {
      return request.resource.data.keys().hasOnly([
        "schemaVersion", "app", "uid", "state", "logs", "tts", "updatedAtMs"
      ]);
    }

    // `let` needs rules_version = '2'. Paste this only into a file that already says that.
    function elsDateShape(value) {
      return value is string && value.size() == 10 && value.matches("^\\d{4}-\\d{2}-\\d{2}$");
    }

    // Rules cannot loop over map values, so each card's due date and types are
    // checked by js/progress-transfer.js before import. An owner who skips the
    // client can still store a bad card inside their own document. That does not
    // let them read another uid or change ownership. Impossible dates such as
    // 2026-02-31 also match the shape check below.
    function elsStateOk() {
      let s = request.resource.data.state;
      return s.keys().hasOnly([
          "topicId", "cards", "daily", "streak", "lastActiveDate", "sentences",
          "activeDays", "checkins", "litCelebrated", "allLitCelebrated",
          "planStartedAt", "stage0PassedAt", "wn", "club", "_litSeeded"
        ])
        && (!("topicId" in s) || (s.topicId is string && s.topicId.size() > 0 && s.topicId.size() <= 40))
        && (!("cards" in s) || (s.cards is map && s.cards.size() <= 800))
        && (!("sentences" in s) || (s.sentences is list && s.sentences.size() <= 500))
        && (!("streak" in s) || (s.streak is int && s.streak >= 0 && s.streak <= 10000))
        && (!("lastActiveDate" in s) || s.lastActiveDate == null || elsDateShape(s.lastActiveDate))
        && (!("planStartedAt" in s) || s.planStartedAt == null || elsDateShape(s.planStartedAt))
        && (!("stage0PassedAt" in s) || s.stage0PassedAt == null || elsDateShape(s.stage0PassedAt))
        && (!("checkins" in s) || (s.checkins is map && s.checkins.size() <= 2000))
        && (!("activeDays" in s) || (s.activeDays is map && s.activeDays.size() <= 2000))
        && (!("daily" in s) || s.daily is map)
        && (!("club" in s) || (s.club is map && (!("episodes" in s.club) || (s.club.episodes is map && s.club.episodes.size() <= 30))))
        && (!("wn" in s) || s.wn is map)
        && (!("litCelebrated" in s) || s.litCelebrated is map)
        && (!("allLitCelebrated" in s) || s.allLitCelebrated is bool)
        && (!("_litSeeded" in s) || s._litSeeded is bool);
    }

    function elsValidBundle(userId) {
      return elsKeysOk()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.app == "english-little-steps"
        && request.resource.data.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.state is map
        && elsStateOk()
        && request.resource.data.logs is list
        && request.resource.data.logs.size() <= 120
        && request.resource.data.tts is map
        && request.resource.data.tts.keys().size() <= 12
        && request.resource.data.updatedAtMs is int
        && request.resource.data.updatedAtMs > 0
        && request.resource.size() < 900000;
    }

    function elsIdentityUnchanged() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.app == resource.data.app
        && request.resource.data.schemaVersion == resource.data.schemaVersion;
    }

    match /englishLittleSteps/{userId} {
      allow read: if elsOwner(userId);
      allow create: if elsOwner(userId) && elsValidBundle(userId);
      allow update: if elsOwner(userId) && elsValidBundle(userId) && elsIdentityUnchanged();
      allow delete: if false;
    }
  }
}


